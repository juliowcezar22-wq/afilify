      "id": "b4b0d1f6-1555-4398-b798-1a967dc1609b",
      "name": "API: Busca Ofertas Mercado Livre"
    },
    {
      "parameters": {
        "jsCode": "// =================== EXTRAÇÃO COM FILTRO ESTRITO DE PERFUMES ===================\nconst items = $input.all();\nconst products = [];\n\nconst KEYWORDS_OBRIGATORIAS = [\n  'PERFUME', 'COLÔNIA', 'COLONIA', 'PARFUM',\n  'EAU DE TOILETTE', 'EAU DE PARFUM',\n  'BODY SPLASH', 'BODY MIST',\n  'FRAGRÂNCIA', 'FRAGRANCIA'\n];\nconst REGEX_EDP_EDT = /\\b(EDP|EDT)\\b/;\n\nconst BLACKLIST = [\n  'SACHÊ', 'SACHE', 'DIFUSOR', 'AROMATIZADOR',\n  'VELA', 'AMBIENTE', 'TECIDO', 'AUTOMOTIVO',\n  'CARRO', 'CHEIRINHO', 'PAPEL', 'GAVETA',\n  'AROMA DE AMBIENTE', 'HOME SPRAY',\n  'SABONETE', 'CREME PERFUMADO', 'HIDRATANTE',\n  'LOÇÃO PERFUMADA', 'LOCAO PERFUMADA',\n  'SHAMPOO', 'CONDICIONADOR', 'DESODORANTE',\n  'ANTITRANSPIRANTE', 'TALCO',\n  'AMOSTRA', 'DECANT', 'MINIATURA', 'TESTER',\n  'POTE VAZIO', 'FRASCO VAZIO', 'PARA REVENDA'\n];\n\nconst seenInThisRun = new Set();\n\nfor (const item of items) {\n  const html = item.json.data || item.json.body || '';\n  if (!html) continue;\n\n  const blocks = html.split('class=\"andes-card poly-card');\n\n  for (let i = 1; i < blocks.length; i++) {\n    const content = blocks[i];\n\n    // ===== TÍTULO =====\n    const titleMatch = content.match(/class=\"poly-component__title\".*?>(.*?)<\\/a>/s);\n    const title = titleMatch ? titleMatch[1].replace(/<.*?>/g, '').trim() : '';\n    if (!title) continue;\n\n    const titleUpper = title.toUpperCase();\n\n    // ===== FILTRO 1: keyword obrigatória de perfume =====\n    const temKeyword = KEYWORDS_OBRIGATORIAS.some(k => titleUpper.includes(k))\n                    || REGEX_EDP_EDT.test(titleUpper);\n    if (!temKeyword) continue;\n\n    // ===== FILTRO 2: blacklist =====\n    if (BLACKLIST.some(k => titleUpper.includes(k))) continue;\n\n    // ===== FILTRO 3: precisa indicar mililitros (frasco real) =====\n    const temML = /\\b\\d{2,4}\\s?ML\\b/i.test(title);\n    if (!temML) continue;\n\n    // ===== LINK + MLB_ID =====\n    const linkMatch = content.match(/href=\"(.*?)\"/s);\n    const link = linkMatch\n      ? (linkMatch[1].startsWith('http') ? linkMatch[1] : 'https://www.mercadolivre.com.br' + linkMatch[1])\n      : '';\n    if (!link) continue;\n\n    const idMatch = link.match(/MLB[-]?\\d{8,15}/i);\n    const mlb_id = idMatch ? idMatch[0].replace(/-/g, '').toUpperCase() : '';\n    if (!mlb_id) continue;\n\n    // ===== FILTRO 4: dedup intra-execução =====\n    if (seenInThisRun.has(mlb_id)) continue;\n    seenInThisRun.add(mlb_id);\n\n    // ===== PREÇOS =====\n    const extractPrice = (htmlBlock) => {\n      if (!htmlBlock) return '';\n      const fractionMatch = htmlBlock.match(/class=\"andes-money-amount__fraction\".*?>(.*?)<\\/span>/);\n      const centsMatch = htmlBlock.match(/class=\"andes-money-amount__cents\".*?>(.*?)<\\/span>/);\n      const fraction = fractionMatch ? fractionMatch[1].replace(/\\./g, '') : '';\n      const cents = centsMatch ? centsMatch[1].trim() : '00';\n      return fraction ? `${fraction},${cents}` : '';\n    };\n\n    const prevBlock = content.match(/<s class=\".*?andes-money-amount--previous.*?>(.*?)<\\/s>/s);\n    const precoAnterior = extractPrice(prevBlock ? prevBlock[1] : '');\n\n    const currentBlock = content.match(/<div class=\"poly-price__current\".*?>(.*?)<\\/div>/s);\n    const novoPreco = extractPrice(currentBlock ? currentBlock[1] : '');\n\n    // ===== FILTRO 5: precisa ter desconto real =====\n    if (!novoPreco || !precoAnterior) continue;\n    const pAnt = parseFloat(precoAnterior.replace(',', '.'));\n    const pNov = parseFloat(novoPreco.replace(',', '.'));\n    if (!(pAnt > pNov)) continue;\n\n    // ===== FILTRO 6: desconto mínimo 10% =====\n    const descontoPct = ((pAnt - pNov) / pAnt) * 100;\n    if (descontoPct < 10) continue;\n\n    // ===== IMAGEM =====\n    const imgMatch = content.match(/<img.*?class=\"poly-component__picture\".*?src=\"(.*?)\"/s)\n                  || content.match(/<img.*?src=\"(.*?)\"/s);\n    let imageUrl = imgMatch ? imgMatch[1] : '';\n    if (imageUrl.startsWith('//')) imageUrl = 'https:' + imageUrl;\n\n    // ===== BADGE (sem usar HTML inteiro) =====\n    const hlMatch = content.match(/class=\"poly-component__highlight\".*?>(.*?)<\\/span>/s);\n    const highlight = hlMatch ? hlMatch[1].replace(/<.*?>/g, '').trim() : '';\n    const hlText = highlight.toUpperCase();\n\n    let finalBadge = 'PROMOÇÃO GERAL';\n    if (hlText.includes('OFERTA DO DIA')) finalBadge = 'OFERTA DO DIA';\n    else if (hlText.includes('RELÂMPAGO') || hlText.includes('RELAMPAGO')) finalBadge = 'OFERTA RELÂMPAGO';\n    else if (hlText.includes('MAIS VENDIDO')) finalBadge = 'MAIS VENDIDO';\n    else if (hlText.includes('CUPOM')) finalBadge = 'CUPOM';\n\n    products.push({\n      json: {\n        mlb_id,\n        eTituloProduto: title,\n        zProdutoLink: link,\n        novoPreco,\n        precoAnterior,\n        descontoPct: Math.round(descontoPct) + '%',\n        imagemLink: imageUrl,\n        highlight: finalBadge\n      }\n    });\n  }\n}\nreturn products;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        304
      ],
