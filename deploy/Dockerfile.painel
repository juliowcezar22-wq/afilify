# Afilify — painel Next.js (standalone). BUILDAR FORA DA VPS (1 vCPU):
#   docker build -f deploy/Dockerfile.painel -t afilify-painel .
#   docker save afilify-painel | ssh vps docker load
FROM node:22-alpine AS build
WORKDIR /app
# better-sqlite3 compila módulo nativo no install — alpine não traz toolchain
RUN apk add --no-cache python3 make g++
RUN corepack enable
COPY painel/package.json painel/pnpm-lock.yaml painel/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY painel/ .
RUN STANDALONE=1 pnpm build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public
EXPOSE 3000
CMD ["node", "server.js"]
