# Afilify — painel Next.js.
# Sem modo standalone: o output-file-tracing do Next + pnpm perde o
# @swc/helpers (MODULE_NOT_FOUND no boot) — bug visto no Mac E na VPS.
# Imagem maior, porém idêntica ao que roda comprovadamente em dev.
FROM node:22-alpine
WORKDIR /app
# better-sqlite3 compila módulo nativo no install — alpine não traz toolchain
RUN apk add --no-cache python3 make g++
RUN corepack enable
COPY painel/package.json painel/pnpm-lock.yaml painel/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY painel/ .
RUN pnpm build
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0
EXPOSE 3000
CMD ["pnpm", "start", "-p", "3000"]
